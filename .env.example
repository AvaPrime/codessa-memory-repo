APP_ENV=development
APP_NAME=codessa-memory
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# ── Embeddings ─────────────────────────────────────────────────────────────────
# local   → sentence-transformers (requires: pip install ".[embeddings]")
#           model must produce 384-dim vectors to match the schema default
# openai  → OpenAI-compatible endpoint (set OPENAI_API_KEY + optionally OPENAI_BASE_URL)
# hash    → legacy keyword-hash fallback (no extra deps, low quality)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── SCEP / Codex LLM extraction ────────────────────────────────────────────────
# Set CODEX_EXTRACTION_PROVIDER=openai to enable structured LLM extraction.
# Falls back to deterministic heuristics when unset or on API failure.
CODEX_EXTRACTION_PROVIDER=
CODEX_EXTRACTION_MODEL=gpt-4.1-mini
CODEX_EXTRACTION_TIMEOUT_S=30

# ── Storage backend ────────────────────────────────────────────────────────────
# local    → JSONL files in LOCAL_DATA_DIR (default, no extra deps)
# postgres → Postgres + pgvector via POSTGRES_DSN (requires: pip install ".[postgres]")
# supabase → alias for postgres
STORAGE_BACKEND=local
LOCAL_DATA_DIR=.data

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/codessa_memory
# For Supabase: use the session pooler connection string from your dashboard.
# POSTGRES_DSN=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Chunking ───────────────────────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120
TOP_K=5
